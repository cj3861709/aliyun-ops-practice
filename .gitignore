# ==============================================================================
# .gitignore —— 运维练习项目
#
# 分类说明：
#   1. 安全     绝对不能进仓库的内容（凭据、密钥）
#   2. 隐私     个人信息（管理员 IP、备考资料）
#   3. 运行时   自动生成或临时产物
#   4. 备份     手工备份文件（有 git 后不需要）
# ==============================================================================

# ── 1. 安全：凭据与密钥 ──────────────────────────────────────────────
.ssh/
*.pem
*.key
id_rsa*
id_ed25519*
*known_hosts*
servers.json

# ── 2. 隐私：个人信息 ────────────────────────────────────────────────
docs/项目文档与简历素材.md

# ── 3. 运行时产物 ────────────────────────────────────────────────────
# 日志与监控数据
logs/
*.log
# 配置备份
backups/
snapshots/
# 站点生成产物（由 lib/generate-site.py 生成）
site/build/
# 早期手工预览页面（已被生成器取代）
site/preview/
# 灾备演练的系统配置副本（含公钥与配置结构）
drills/
staging/
# 故障注入的中间状态
quests/.state/

# ── 4. 临时文件与手工备份 ────────────────────────────────────────────
*.tar
*.tar.gz
*.tmp
*.bak
*.bak-*
__pycache__/
*.pyc
